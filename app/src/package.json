{
  "name": "enterprise-devops-app",
  "version": "2.0.0",
  "description": "Enterprise DevOps Capstone Project Application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage tests/unit/",
    "test:watch": "jest --watch",
    "test:integration": "jest tests/integration/",
    "test:load": "k6 run ../tests/load/k6-load.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "security-check": "npm audit --audit-level=critical",
    "dependency-check": "npx audit-ci --critical",
    "docker:build": "docker build -t enterprise-devops-app .",
    "docker:run": "docker run -p 3000:3000 --env-file .env enterprise-devops-app",
    "coverage": "jest --coverage tests/unit/"
  },
  "keywords": [
    "devops",
    "kubernetes",
    "aws",
    "ci-cd",
    "production",
    "enterprise"
  ],
  "author": "DevOps Engineer",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1161.0",
    "axios": "^1.4.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "opossum": "^8.0.0",
    "prom-client": "^14.2.0",
    "redis": "^4.6.7",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.4.5",
    "@types/supertest": "^2.0.12",
    "eslint": "^8.45.0",
    "jest": "^29.5.0",
    "jest-extended": "^7.0.0",
    "jest-junit": "^16.0.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "jest": {
    "roots": [
      "<rootDir>",
      "<rootDir>/../tests"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "collectCoverageFrom": [
      "server.js",
      "secrets.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 50,
        "lines": 60,
        "statements": 60
      }
    },
    "testEnvironment": "node",
    "reporters": [
      "default",
      "jest-junit"
    ],
    "setupFilesAfterEnv": [
      "../tests/setup.js",
      "jest-extended/all"
    ]
  }
}

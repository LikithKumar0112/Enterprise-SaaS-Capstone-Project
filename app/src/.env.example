NODE_ENV=development
PORT=3000
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379
EXTERNAL_API_URL=https://api.mocki.io/v2/5143e9e3
APP_VERSION=2.0.0
ALLOWED_ORIGINS=http://localhost:3000
# Optional. In EKS the password comes from Secrets Manager through AWS_SECRET_NAME.
REDIS_PASSWORD=
AWS_SECRET_NAME=
# Number of proxies in front of the app. Set to 1 behind the ALB.
TRUST_PROXY_HOPS=0
RATE_LIMIT_MAX=100
